diff --git a/kernel/feature/susfs_cmd.c b/kernel/feature/susfs_cmd.c
new file mode 100644
index 0000000..102be7c
--- /dev/null
+++ b/kernel/feature/susfs_cmd.c
@@ -0,0 +1,261 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal SUSFS prctl command bridge for downstream KernelSU builds.
+ *
+ * The SUSFS userspace tool still uses the historical
+ * prctl(KERNEL_SU_OPTION, CMD_SUSFS_*, ...) interface.  Newer KernelSU
+ * trees moved the manager interface to an ioctl fd, so expose just the
+ * SUSFS commands through a kprobe on the arm64 prctl syscall wrapper.
+ */
+
+#ifdef CONFIG_KSU_SUSFS
+
+#include <linux/kernel.h>
+#include <linux/cred.h>
+#include <linux/kprobes.h>
+#include <linux/sched.h>
+#include <linux/uaccess.h>
+#include <linux/version.h>
+#include <linux/susfs.h>
+
+#if defined(__aarch64__)
+#define SUSFS_PT_REGS_PARM1(x) ((x)->regs[0])
+#define SUSFS_PT_REGS_PARM2(x) ((x)->regs[1])
+#define SUSFS_PT_REGS_PARM3(x) ((x)->regs[2])
+#define SUSFS_PT_REGS_PARM4(x) ((x)->regs[3])
+#define SUSFS_PT_REGS_PARM5(x) ((x)->regs[4])
+#define SUSFS_PRCTL_SYMBOL "__arm64_sys_prctl"
+#else
+#error "susfs_cmd.c currently supports arm64 only"
+#endif
+
+#define SUSFS_KERNEL_SU_OPTION 0xDEADBEEF
+
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+int susfs_add_sus_path_loop(struct st_susfs_sus_path * __user user_info);
+#endif
+
+static bool susfs_access_ok(const void __user *addr, unsigned long size)
+{
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 0, 0)
+	return access_ok(VERIFY_READ, addr, size);
+#else
+	return access_ok(addr, size);
+#endif
+}
+
+static int susfs_reply_error(unsigned long result, int error)
+{
+	if (copy_to_user((void __user *)result, &error, sizeof(error)))
+		pr_info("susfs: copy_to_user() failed\n");
+	return 0;
+}
+
+int ksu_handle_susfs_prctl(int option, unsigned long arg2, unsigned long arg3,
+			   unsigned long arg4, unsigned long arg5)
+{
+	void __user *arg3p = (void __user *)arg3;
+	int error = 0;
+
+	if (option != SUSFS_KERNEL_SU_OPTION)
+		return 0;
+	if (current_uid().val != 0)
+		return 0;
+
+	switch (arg2) {
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	case CMD_SUSFS_ADD_SUS_PATH:
+		if (!susfs_access_ok((struct st_susfs_sus_path __user *)arg3p, sizeof(*(struct st_susfs_sus_path __user *)arg3p)) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_sus_path((struct st_susfs_sus_path __user *)arg3p);
+		return susfs_reply_error(arg5, error);
+	case CMD_SUSFS_ADD_SUS_PATH_LOOP:
+		if (!susfs_access_ok((struct st_susfs_sus_path __user *)arg3p, sizeof(*(struct st_susfs_sus_path __user *)arg3p)) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_sus_path_loop((struct st_susfs_sus_path __user *)arg3p);
+		return susfs_reply_error(arg5, error);
+	case CMD_SUSFS_SET_ANDROID_DATA_ROOT_PATH:
+	case CMD_SUSFS_SET_SDCARD_ROOT_PATH:
+		if (!susfs_access_ok((void __user *)arg3, SUSFS_MAX_LEN_PATHNAME) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_set_i_state_on_external_dir((char __user *)arg3, arg2);
+		return susfs_reply_error(arg5, error);
+#endif
+
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+	case CMD_SUSFS_ADD_SUS_MOUNT:
+		if (!susfs_access_ok((struct st_susfs_sus_mount __user *)arg3p, sizeof(*(struct st_susfs_sus_mount __user *)arg3p)) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_sus_mount((struct st_susfs_sus_mount __user *)arg3p);
+		return susfs_reply_error(arg5, error);
+#endif
+
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	case CMD_SUSFS_ADD_SUS_KSTAT:
+	case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+		if (!susfs_access_ok((struct st_susfs_sus_kstat __user *)arg3p, sizeof(*(struct st_susfs_sus_kstat __user *)arg3p)) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_sus_kstat((struct st_susfs_sus_kstat __user *)arg3p);
+		return susfs_reply_error(arg5, error);
+	case CMD_SUSFS_UPDATE_SUS_KSTAT:
+		if (!susfs_access_ok((struct st_susfs_sus_kstat __user *)arg3p, sizeof(*(struct st_susfs_sus_kstat __user *)arg3p)) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_update_sus_kstat((struct st_susfs_sus_kstat __user *)arg3p);
+		return susfs_reply_error(arg5, error);
+#endif
+
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+	case CMD_SUSFS_ADD_TRY_UMOUNT:
+		if (!susfs_access_ok((struct st_susfs_try_umount __user *)arg3p, sizeof(*(struct st_susfs_try_umount __user *)arg3p)) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_try_umount((struct st_susfs_try_umount __user *)arg3p);
+		return susfs_reply_error(arg5, error);
+#endif
+
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+	case CMD_SUSFS_SET_UNAME:
+		if (!susfs_access_ok((struct st_susfs_uname __user *)arg3p, sizeof(*(struct st_susfs_uname __user *)arg3p)) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_set_uname((struct st_susfs_uname __user *)arg3p);
+		return susfs_reply_error(arg5, error);
+#endif
+
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+	case CMD_SUSFS_ENABLE_LOG:
+		if (arg3 != 0 && arg3 != 1)
+			return 0;
+		susfs_set_log(arg3);
+		return susfs_reply_error(arg5, 0);
+#endif
+
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	case CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG:
+		if (!susfs_access_ok((void __user *)arg3,
+				     SUSFS_FAKE_CMDLINE_OR_BOOTCONFIG_SIZE) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_set_cmdline_or_bootconfig((char __user *)arg3);
+		return susfs_reply_error(arg5, error);
+#endif
+
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+	case CMD_SUSFS_ADD_OPEN_REDIRECT:
+		if (!susfs_access_ok((struct st_susfs_open_redirect __user *)arg3p, sizeof(*(struct st_susfs_open_redirect __user *)arg3p)) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_open_redirect((struct st_susfs_open_redirect __user *)arg3p);
+		return susfs_reply_error(arg5, error);
+#endif
+
+#ifdef CONFIG_KSU_SUSFS_SUS_SU
+	case CMD_SUSFS_SUS_SU:
+		if (!susfs_access_ok((struct st_sus_su __user *)arg3p, sizeof(*(struct st_sus_su __user *)arg3p)) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_sus_su((struct st_sus_su __user *)arg3p);
+		return susfs_reply_error(arg5, error);
+	case CMD_SUSFS_SHOW_SUS_SU_WORKING_MODE:
+		if (!susfs_access_ok((void __user *)arg3, sizeof(int)) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_get_sus_su_working_mode();
+		return susfs_reply_error(arg5, error);
+	case CMD_SUSFS_IS_SUS_SU_READY:
+		if (!susfs_access_ok((void __user *)arg3, sizeof(bool)) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_get_sus_su_working_mode() != SUS_SU_DISABLED;
+		return susfs_reply_error(arg5, error);
+#endif
+
+	case CMD_SUSFS_SHOW_VERSION: {
+		const char *version = SUSFS_VERSION;
+		int len = strlen(version) + 1;
+
+		if (!susfs_access_ok((void __user *)arg3, len) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = copy_to_user((void __user *)arg3, version, len);
+		return susfs_reply_error(arg5, error);
+	}
+	case CMD_SUSFS_SHOW_VARIANT: {
+		const char *variant = SUSFS_VARIANT;
+		int len = strlen(variant) + 1;
+
+		if (!susfs_access_ok((void __user *)arg3, len) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = copy_to_user((void __user *)arg3, variant, len);
+		return susfs_reply_error(arg5, error);
+	}
+	case CMD_SUSFS_SHOW_ENABLED_FEATURES:
+		if (!susfs_access_ok((void __user *)arg3, 4096) ||
+		    !susfs_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_get_enabled_features((char __user *)arg3, 4096);
+		return susfs_reply_error(arg5, error);
+
+	case CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING:
+		if (arg3 != 0 && arg3 != 1)
+			return 0;
+		susfs_set_avc_log_spoofing(!!arg3);
+		return susfs_reply_error(arg5, 0);
+
+	default:
+		return 0;
+	}
+}
+
+static int susfs_prctl_pre_handler(struct kprobe *p, struct pt_regs *regs)
+{
+	struct pt_regs *real_regs = (struct pt_regs *)SUSFS_PT_REGS_PARM1(regs);
+	unsigned long arg2, arg3, arg4, arg5;
+	unsigned long option;
+
+	if (!real_regs)
+		return 0;
+
+	option = SUSFS_PT_REGS_PARM1(real_regs);
+	if (option != SUSFS_KERNEL_SU_OPTION)
+		return 0;
+
+	arg2 = SUSFS_PT_REGS_PARM2(real_regs);
+	arg3 = SUSFS_PT_REGS_PARM3(real_regs);
+	arg4 = SUSFS_PT_REGS_PARM4(real_regs);
+	arg5 = SUSFS_PT_REGS_PARM5(real_regs);
+	(void)arg4;
+
+	ksu_handle_susfs_prctl((int)option, arg2, arg3, arg4, arg5);
+	return 0;
+}
+
+static struct kprobe susfs_prctl_kp = {
+	.symbol_name = SUSFS_PRCTL_SYMBOL,
+	.pre_handler = susfs_prctl_pre_handler,
+};
+
+int susfs_prctl_kprobe_init(void)
+{
+	int ret = register_kprobe(&susfs_prctl_kp);
+
+	if (ret)
+		pr_info("susfs: prctl kprobe registration failed: %d\n", ret);
+	else
+		pr_info("susfs: prctl command bridge registered\n");
+	return ret;
+}
+
+#else
+int susfs_prctl_kprobe_init(void)
+{
+	return 0;
+}
+#endif
diff --git a/kernel/hook/lsm_hooks_list.c b/kernel/hook/lsm_hooks_list.c
