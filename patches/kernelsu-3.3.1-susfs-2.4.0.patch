diff --git a/kernel/hook/setuid_hook.c b/kernel/hook/setuid_hook.c
index 92579804..94e01415 100644
--- a/kernel/hook/setuid_hook.c
+++ b/kernel/hook/setuid_hook.c
@@ -1,3 +1,14 @@
+#include <linux/susfs_def.h>
+
+extern struct work_struct susfs_extra_works;
+
+static inline void ksu_handle_extra_susfs_work(void)
+{
+	if (work_pending(&susfs_extra_works))
+		return;
+	schedule_work(&susfs_extra_works);
+}
+
 static __always_inline void ksu_handle_setresuid_cred(struct cred *new, const struct cred *old)
 {
 	if (!new || !old)
@@ -15,14 +26,37 @@ static __always_inline void ksu_handle_setresuid_cred(struct cred *new, const st
 
 	// we dont have those new fancy things upstream has
 	// lets just do the original thing where we disable seccomp
-	if (unlikely(is_uid_manager(new_uid)))
+	if (unlikely(is_uid_manager(new_uid))) {
+		susfs_clear_current_proc_umounted();
+		susfs_clear_current_proc_no_su();
 		goto install_ksu_fd;
+	}
 
-	if (ksu_is_allow_uid_for_current(new_uid))
+	if (ksu_is_allow_uid_for_current(new_uid)) {
+		susfs_clear_current_proc_umounted();
+		susfs_clear_current_proc_no_su();
 		goto kill_seccomp;
+	}
+
+	// Only mark real app processes spawned by zygote. Never mark
+	// shell/init/other system UIDs with TIF_PROC_NO_SU, otherwise KSU's
+	// execve sucompat path cannot see them.
+	if (is_zygote(old) &&
+	    (is_appuid(new_uid) || is_isolated_process(new_uid) ||
+	     new_uid == WEBVIEW_ZYGOTE_UID)) {
+		susfs_set_current_proc_no_su();
 
-	// Handle kernel umount
-	ksu_handle_umount(new, old);
+		if (ksu_uid_should_umount(new_uid) ||
+		    is_isolated_process(new_uid) ||
+		    new_uid == WEBVIEW_ZYGOTE_UID) {
+			susfs_set_current_proc_umounted();
+			// Handle kernel umount and deferred SUSFS work
+			ksu_handle_umount(new, old);
+			ksu_handle_extra_susfs_work();
+		} else {
+			susfs_clear_current_proc_umounted();
+		}
+	}
 	return;
 
 install_ksu_fd:
